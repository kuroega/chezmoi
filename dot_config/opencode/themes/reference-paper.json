{
  "$schema": "https://opencode.ai/theme.json",
  "defs": {
    "paper": "#ffffff",
    "ink": "#262626",
    "silverBlueInk": "#5c7690",
    "strong": "#171717",
    "muted": "#737373",
    "dim": "#a3a3a3",
    "line": "#d4d4d4",
    "faintLine": "#e5e5e5",
    "chrome": "#fafafa",
    "selection": "#e5e5e5",
    "search": "#d4d4d4"
  },
  "theme": {
    "primary": { "dark": "strong", "light": "strong" },
    "secondary": { "dark": "silverBlueInk", "light": "silverBlueInk" },
    "accent": { "dark": "strong", "light": "strong" },
    "error": { "dark": "strong", "light": "strong" },
    "warning": { "dark": "ink", "light": "ink" },
    "success": { "dark": "strong", "light": "strong" },
    "info": { "dark": "ink", "light": "ink" },
    "text": { "dark": "ink", "light": "ink" },
    "textMuted": { "dark": "muted", "light": "muted" },
    "background": { "dark": "paper", "light": "paper" },
    "backgroundPanel": { "dark": "chrome", "light": "chrome" },
    "backgroundElement": { "dark": "selection", "light": "selection" },
    "border": { "dark": "line", "light": "line" },
    "borderActive": { "dark": "strong", "light": "strong" },
    "borderSubtle": { "dark": "faintLine", "light": "faintLine" },
    "diffAdded": { "dark": "strong", "light": "strong" },
    "diffRemoved": { "dark": "muted", "light": "muted" },
    "diffContext": { "dark": "muted", "light": "muted" },
    "diffHunkHeader": { "dark": "muted", "light": "muted" },
    "diffHighlightAdded": { "dark": "strong", "light": "strong" },
    "diffHighlightRemoved": { "dark": "muted", "light": "muted" },
    "diffAddedBg": { "dark": "paper", "light": "paper" },
    "diffRemovedBg": { "dark": "paper", "light": "paper" },
    "diffContextBg": { "dark": "paper", "light": "paper" },
    "diffLineNumber": { "dark": "dim", "light": "dim" },
    "diffAddedLineNumberBg": { "dark": "paper", "light": "paper" },
    "diffRemovedLineNumberBg": { "dark": "paper", "light": "paper" },
    "markdownText": { "dark": "ink", "light": "ink" },
    "markdownHeading": { "dark": "strong", "light": "strong" },
    "markdownLink": { "dark": "ink", "light": "ink" },
    "markdownLinkText": { "dark": "silverBlueInk", "light": "silverBlueInk" },
    "markdownCode": { "dark": "strong", "light": "strong" },
    "markdownBlockQuote": { "dark": "muted", "light": "muted" },
    "markdownEmph": { "dark": "ink", "light": "ink" },
    "markdownStrong": { "dark": "strong", "light": "strong" },
    "markdownHorizontalRule": { "dark": "faintLine", "light": "faintLine" },
    "markdownListItem": { "dark": "ink", "light": "ink" },
    "markdownListEnumeration": { "dark": "ink", "light": "ink" },
    "markdownImage": { "dark": "ink", "light": "ink" },
    "markdownImageText": { "dark": "muted", "light": "muted" },
    "markdownCodeBlock": { "dark": "ink", "light": "ink" },
    "syntaxComment": { "dark": "muted", "light": "muted" },
    "syntaxKeyword": { "dark": "strong", "light": "strong" },
    "syntaxFunction": { "dark": "ink", "light": "ink" },
    "syntaxVariable": { "dark": "ink", "light": "ink" },
    "syntaxString": { "dark": "muted", "light": "muted" },
    "syntaxNumber": { "dark": "muted", "light": "muted" },
    "syntaxType": { "dark": "strong", "light": "strong" },
    "syntaxOperator": { "dark": "ink", "light": "ink" },
    "syntaxPunctuation": { "dark": "muted", "light": "muted" }
  }
}
